# Custom (#21): copy to .env (mode 600) and fill in the keys you use. config.yaml refers to them as ${VAR};
# a variable already set in the environment wins over .env. See "Key trong .env" in CUSTOM.md.
# Never commit .env.

# LLM, api.key (the custom profile)
LLM_API_KEY=
# OpenRouter: the openrouter LLM profile (api_key_env) and whisper.mai_openrouter_api_key
OPENROUTER_API_KEY=
# ASR
SONIOX_API_KEY=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
# TTS
OPENAI_TTS_API_KEY=
API_302_KEY=
SILICONFLOW_API_KEY=
FISH_AUDIO_API_KEY=
# Google Cloud (Vertex LLM profiles and vertex_tts): path of the service-account key JSON
GOOGLE_APPLICATION_CREDENTIALS=
